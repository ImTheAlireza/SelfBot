# ============================================================================
#  SelfBot configuration
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# --- Telegram (required) ----------------------------------------------------
# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# International format, e.g. +31612345678. Optional: you can log in interactively.
TELEGRAM_PHONE=
# Name of the .session file (stored under DATA_DIR)
TELEGRAM_SESSION=selfbot

# --- Ownership (required) ---------------------------------------------------
# Your own Telegram user ID. Grants owner/sudo privileges.
# Leave blank: `python -m selfbot --login` fills this in automatically.
SUDO_USER_ID=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Optional private channel for log mirroring, e.g. -1001234567890
LOG_CHANNEL_ID=
# Minimum level mirrored to Telegram (WARNING keeps the channel quiet)
LOG_CHANNEL_LEVEL=WARNING

# --- Storage ----------------------------------------------------------------
# Where sessions, the database and temp downloads live.
DATA_DIR=./data
# Leave blank to use a SQLite file inside DATA_DIR (zero setup).
# Override only if you want a different location or MySQL:
#   sqlite+aiosqlite:///./somewhere/selfbot.db
#   mysql+aiomysql://user:pass@localhost/selfbot
DATABASE_URL=

# --- Command dispatch -------------------------------------------------------
# Optional prefix required before commands, e.g. "." makes it `.help`.
# Leave empty to keep the original bare-word behaviour (`help`).
COMMAND_PREFIX=
# Prefix that triggers quick replies (`-alias`)
QUICK_REPLY_PREFIX=-

# Post a summary when the bot comes online.
#   me   -> Saved Messages (default)
#   off  -> stay silent
#   <id> -> a specific chat, e.g. -1001234567890
STARTUP_NOTIFY=me

# --- External plugins -------------------------------------------------------
# Directory for external plugin modules (single .py files or packages).
# Defaults to DATA_DIR/plugins.
PLUGINS_DIR=

# --- Observability ----------------------------------------------------------
# Optional localhost HTTP health endpoint for Docker HEALTHCHECK / monitors.
# Leave HEALTH_PORT empty to disable. Binds to 127.0.0.1 by default.
HEALTH_BIND=127.0.0.1
# HEALTH_PORT=8080

# --- Behaviour tuning -------------------------------------------------------
SPAM_DELAY=1.5
SPAM_LIMIT=50
SPAM_COOLDOWN=4
# Hard ceiling on files the bot will download/upload (MiB)
MAX_FILE_SIZE_MB=512
# Auto-delete downloaded temp files older than this (minutes)
TEMP_TTL_MINUTES=60

# --- Process management (optional, for `self status|logs`) ------------------
# The [program:NAME] section in your supervisord config. `self restart` does
# not require this: it safely re-executes the current process directly.
SUPERVISOR_PROCESS=selfbot
# Path to supervisord.conf. Leave blank to let supervisorctl find its own
# (it checks /etc/supervisord.conf and ./supervisord.conf).
SUPERVISOR_CONFIG=
# Absolute path to the supervisorctl binary. Leave blank to auto-discover:
# PATH, the bot's virtualenv, ~/.local/bin, ~/virtualenv/*, /usr/local/bin,
# then `python -m supervisor.supervisorctl`.
# Run `self diag` in Telegram if discovery fails.
SUPERVISOR_CTL=
# stderr log to tail with `self logs`
SUPERVISOR_LOG_FILE=

# --- Stickers (optional) ----------------------------------------------------
# Helper bot from @BotFather, required for `stickerpack`
STICKER_BOT_TOKEN=
STICKER_BOT_USERNAME=
# Text stamped on generated stickers. Leave empty for none.
STICKER_WATERMARK=

# --- AI (optional) ----------------------------------------------------------
# AI providers and API keys are now stored in the DATABASE and managed in
# Telegram with `provider add/list/test`, `gptmodel`, and `aistatus`. The
# variables below are a one-time SEED used only when ai_providers is empty
# (e.g. on first run). After that, manage everything via the bot commands.
#
# Primary OpenAI-compatible provider (seeded as the default on first run).
ANYAPI_KEY=
ANYAPI_BASE_URL=https://api.anyapi.ai/v1
# Any model on the platform, e.g. anthropic/claude-sonnet-5 or openai/gpt-4o-mini.
ANYAPI_MODEL=anthropic/claude-sonnet-5
# Secondary OpenAI-compatible provider, used when the primary is unavailable.
BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUESMINDS_MODEL=anthropic/claude-sonnet-5
# Legacy fallback used only if the OpenAI-compatible providers are unavailable
# (chatgpt-api8 & adult-gpt on RapidAPI).
RAPIDAPI_KEY=

# Conversation memory and quota-cooldown tuning.
AI_MEMORY_TURNS=10
AI_MEMORY_BUDGET=24000
AI_COOLDOWN_MAX=900
