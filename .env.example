# ============================================================================
#  SelfBot configuration
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# --- Telegram (required) ----------------------------------------------------
# Get these from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# International format, e.g. +31612345678. Optional: you can log in interactively.
TELEGRAM_PHONE=
# Name of the .session file (stored under DATA_DIR)
TELEGRAM_SESSION=selfbot

# --- Ownership (required) ---------------------------------------------------
# Your own Telegram user ID. Grants owner/sudo privileges.
# Leave blank: `python -m selfbot --login` fills this in automatically.
SUDO_USER_ID=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Optional private channel for log mirroring, e.g. -1001234567890
LOG_CHANNEL_ID=
# Minimum level mirrored to Telegram (WARNING keeps the channel quiet)
LOG_CHANNEL_LEVEL=WARNING

# --- Storage ----------------------------------------------------------------
# Where sessions, the database and temp downloads live.
DATA_DIR=./data
# Leave blank to use a SQLite file inside DATA_DIR (zero setup).
# Override only if you want a different location or MySQL:
#   sqlite+aiosqlite:///./somewhere/selfbot.db
#   mysql+aiomysql://user:pass@localhost/selfbot
DATABASE_URL=

# --- Command dispatch -------------------------------------------------------
# Optional prefix required before commands, e.g. "." makes it `.help`.
# Leave empty to keep the original bare-word behaviour (`help`).
COMMAND_PREFIX=
# Prefix that triggers quick replies (`-alias`)
QUICK_REPLY_PREFIX=-

# --- AI providers -----------------------------------------------------------
# Which backend `gpt` / `gpts` / `gptr` use:
#   openai | openrouter | agentrouter | anthropic | rapidapi | none
AI_PROVIDER=none
AI_API_KEY=
# Override the base URL for OpenAI-compatible gateways (LM Studio, Ollama, vLLM, ...)
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
# Model used by `gptr` (reasoning). Falls back to AI_MODEL when unset.
AI_REASONING_MODEL=
AI_MAX_TOKENS=2048
AI_TIMEOUT=120

# Image generation: openai | agentrouter | rapidapi | none
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Third-party APIs (all optional; features degrade gracefully) -----------
# RapidAPI powers weather, books, TTS and the legacy AI endpoints
RAPIDAPI_KEY=
# Text-to-speech: rapidapi | none
TTS_PROVIDER=none

# --- Behaviour tuning -------------------------------------------------------
SPAM_DELAY=1.5
SPAM_LIMIT=50
SPAM_COOLDOWN=4
# Hard ceiling on files the bot will download/upload (MiB)
MAX_FILE_SIZE_MB=512
# Auto-delete downloaded temp files older than this (minutes)
TEMP_TTL_MINUTES=60

# --- Process management (optional, for `self restart|status|logs`) ----------
SUPERVISOR_CONFIG=
SUPERVISOR_PROCESS=selfbot
SUPERVISOR_LOG_FILE=

# --- Stickers (optional) ----------------------------------------------------
# Helper bot from @BotFather, required for `stickerpack`
STICKER_BOT_TOKEN=
STICKER_BOT_USERNAME=
# Text stamped on generated stickers. Leave empty for none.
STICKER_WATERMARK=
